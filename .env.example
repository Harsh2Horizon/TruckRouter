DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-for-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_ENGINE=postgresql
POSTGRES_DB=truckroute
POSTGRES_USER=truckrouter
POSTGRES_PASSWORD=truckrouter
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
# Explicitly configure a self-hosted Nominatim service for live candidate retrieval.
# The application deliberately does not use nominatim.openstreetmap.org.
NOMINATIM_BASE_URL=
GEOCODER_USER_AGENT="truckroute/0.1 (contact: your-email@example.com)"
OVERPASS_URL=https://overpass-api.de/api/interpreter
