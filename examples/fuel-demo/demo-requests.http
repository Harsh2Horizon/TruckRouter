@baseUrl = http://127.0.0.1:8000
@algorithm = greedy

### 1. New York → Boston — Zero-refuel trip
POST {{baseUrl}}/api/fuel/{{algorithm}}/
Content-Type: application/json

{
  "origin": {
    "latitude": 40.7128,
    "longitude": -74.006
  },
  "destination": {
    "latitude": 42.3601,
    "longitude": -71.0589
  },
  "corridor_miles": 5,
  "detour_multiplier": 1.4
}

