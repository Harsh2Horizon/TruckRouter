{
  "info": {
    "name": "Truckroute \u2014 6 fuel optimization demos",
    "description": "Six checked examples, each with greedy and Dijkstra requests. Run the Django server on baseUrl. Results depend on the current station data and OSRM route.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. New York \u2192 Boston",
      "description": "Zero-refuel trip",
      "item": [
        {
          "name": "Greedy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"origin\": {\n    \"latitude\": 40.7128,\n    \"longitude\": -74.006\n  },\n  \"destination\": {\n    \"latitude\": 42.3601,\n    \"longitude\": -71.0589\n  },\n  \"corridor_miles\": 5,\n  \"detour_multiplier\": 1.4\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/fuel/greedy/",
            "description": "Zero-refuel trip"
          }
        },
        {
          "name": "Dijkstra",
